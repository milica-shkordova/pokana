{
  "name": "pokanito",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web,admin -c blue,magenta,green \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:admin\"",
    "dev:api": "npm run dev -w @pokanito/api",
    "dev:web": "npm run dev -w @pokanito/web",
    "dev:admin": "npm run dev -w @pokanito/admin",
    "build": "npm run build -w @pokanito/api && npm run build -w @pokanito/web && npm run build -w @pokanito/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "db:migrate": "npm run db:migrate -w @pokanito/api",
    "db:seed": "npm run db:seed -w @pokanito/api",
    "db:studio": "npm run db:studio -w @pokanito/api",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0"
  }
}
