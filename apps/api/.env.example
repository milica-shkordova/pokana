# Copy to apps/api/.env

# SQLite file, relative to prisma/schema.prisma. For Postgres use e.g.
# postgresql://user:pass@host:5432/momentelo (and change the provider in schema.prisma).
DATABASE_URL="file:./dev.db"

PORT=4000

# Signs admin sessions, preview links and unlock tokens. Use a long random
# string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-secret-change-me-dev-only-secret-change-me"

# Public site (preview links, revalidation, emails) and admin (invite links).
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3000/admin"
# Shared with apps/web — lets the API ask the site to rebuild a page on change.
REVALIDATE_SECRET="dev-revalidate-secret"

# First owner account, created/updated by `npm run db:seed`.
ADMIN_EMAIL="admin@momentelo.mk"
ADMIN_PASSWORD="change-me-please"
ADMIN_NAME="Kristijan"

# Email (RSVPs to clients, test emails, lead alerts, team invites) via Resend.
# Leave empty in development: emails are printed to the API console instead.
# The sending domain (e.g. momentelo.mk for rsvp@momentelo.mk) must be verified in Resend;
# the from-address itself is set in Admin › Settings › RSVP emails.
RESEND_API_KEY=

# Media storage. "local" keeps files in apps/api/storage (dev / single server).
# "s3" works with any S3-compatible bucket — e.g. Cloudflare R2:
#   MEDIA_DRIVER=s3
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_BUCKET=momentelo-media
#   S3_ACCESS_KEY_ID=...
#   S3_SECRET_ACCESS_KEY=...
#   MEDIA_PUBLIC_URL=https://media.momentelo.mk   # public bucket / CDN domain (optional)
MEDIA_DRIVER=local
MEDIA_QUOTA_GB=10

# Clients' daily RSVP summary (when enabled in Settings) goes out after this hour, Skopje time.
DIGEST_HOUR=20
