# Copy to apps/admin/.env.local

# The admin runs under /admin (basePath). Open it via the public site:
# http://localhost:3000/admin (or directly at http://localhost:3001/admin).

# Internal URL of the API (target of the /api/* rewrite).
API_URL=http://localhost:4000

# Public site — used for "open live invitation" links.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
