# Copy to apps/web/.env.local

# Internal URL of the API (used server-side and by the /api/public rewrite).
API_URL=http://localhost:4000

# Public origin of this site — absolute URLs in link previews (og:image), sitemap, robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public URL of the admin (shown at /admin on this site). Its origin may frame
# /preview and drive it via postMessage.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin

# Where the admin app itself runs (its own deploy); /admin/* is proxied there.
ADMIN_APP_URL=http://localhost:3001

# Must match REVALIDATE_SECRET in apps/api/.env
REVALIDATE_SECRET=dev-revalidate-secret
