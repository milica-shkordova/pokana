# Copy this file to .env.local and fill in real values.
# Web3Forms access keys (https://web3forms.com) — one per client, plus one for
# the Invy landing page's contact form. Keys are NEXT_PUBLIC_ because the
# submission happens client-side.

# Landing page contact form
NEXT_PUBLIC_INVY_CONTACT_WEB3FORMS_KEY=

# Per-client RSVP forms — name follows NEXT_PUBLIC_WEB3FORMS_KEY_<SLUG_UPPER_SNAKE>
NEXT_PUBLIC_WEB3FORMS_KEY_TATJANA_I_DRAGAN=
NEXT_PUBLIC_WEB3FORMS_KEY_DEMO_WEDDING=
